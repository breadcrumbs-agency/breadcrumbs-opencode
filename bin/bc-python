#!/bin/sh
# Run Python (3.11 or newer) with the breadcrumbs layers on PYTHONPATH, and the default memory of OpenCode.
# A bundle (tools/bundle.py) puts the layers under lib/; a source checkout finds the sibling breadcrumbs-common and
# breadcrumbs-spacegraph folders. BREADCRUMBS_HOME names the memory (it must end in /breadcrumbs); BREADCRUMBS_PY names
# the Python to use. The plugin (plugin/index.js) runs every command of breadcrumbs through this file.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -d "$root/lib" ]; then
  export PYTHONPATH="$root/lib:$root${PYTHONPATH:+:$PYTHONPATH}"
else
  parts=$(CDPATH= cd -- "$root/.." && pwd)
  source_path="$root"
  [ -d "$parts/breadcrumbs-spacegraph" ] && source_path="$parts/breadcrumbs-spacegraph:$source_path"
  [ -d "$parts/breadcrumbs-common" ] && source_path="$parts/breadcrumbs-common:$source_path"
  export PYTHONPATH="$source_path${PYTHONPATH:+:$PYTHONPATH}"
fi
export BREADCRUMBS_HOME="${BREADCRUMBS_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/opencode/breadcrumbs}"
for py in "${BREADCRUMBS_PY:-}" python3.13 python3.12 python3.11 python3; do
  [ -n "$py" ] || continue
  if command -v "$py" >/dev/null 2>&1 && "$py" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
    exec "$py" "$@"
  fi
done
echo "breadcrumbs: needs Python 3.11 or newer (set BREADCRUMBS_PY)" >&2
exit 1
